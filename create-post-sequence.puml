@startuml
actor User
boundary "UI" as UI
control "PostService" as C
entity "New:Post" as P
participant "UserRepository" as UR <<repository>>
participant "PostRepository" as PTR <<repository>>
participant "ImageRepository" as IR <<repository>>
entity "actual:Sesion" as S

User -> UI : optionCreatePost()
UI -> UI: showNewPost()
User -> UI: takeTitle()
User -> UI: takeContent()
User -> UI: takePostType()
UI -> UI: regexValidateFields()
User -> UI: takeImage()
UI -> UI: covertImageToBase64()
UI -> UI: getSesion()
UI -> S: getSesion()
UI -> C: createPost()
C -> UR: authUser() 
create P
C --> P : new()

C -> C: resolveProfileType(profileId)
alt Perfil USER
    C -> P: setPageProfile(null)
else Perfil PAGE
    C -> C: validatePageMembership()
    C -> P: setPageProfile(page)
end

alt Tiene imagen
    C -> IR: upload(image)
    C -> P: setImageId()
end

C -> CR: getByPostTypeId(postTypeId)
alt PostType no existe
    C -> C: throw POSTTYPE_NOT_FOUND
else PostType válido
    C -> P: setPostType()
end

C -> P: setId()
C -> P: setAuthor()
C -> P: setTitle()
C -> P: setContent()
C -> P: setStatus(ACTIVE)
C -> P: setViews(0)
C -> P: setUpVoters([])
C -> P: setDownVoters([])
C -> P: setCreatedAt()
C -> P: setUpdatedAt()

C -> PTR: save()
C -> C: createPostResponse()
C -> UI: createPostResponse()
UI -> UI: displaySuscess()
UI -> UI: navigatePostDetail()
C -> C : endUS()

hide footbox
@enduml
